// Spec 9, D11: the Vite build served as Workers static assets, no Worker script.
// Cloudflare's GitHub integration (Workers Builds) runs `pnpm build:cloudflare`, then
// deploys main to production and uploads every other branch as a preview version.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shei",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist/",
    // Deep links such as /play get index.html instead of a 404.
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "shei.parlaplay.games", "custom_domain": true }],
  // Production lives only on the custom domain. Preview URLs are on workers.dev,
  // so they stay on while the workers.dev route for production is off.
  "workers_dev": false,
  "preview_urls": true,
}
